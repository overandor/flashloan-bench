# Berachain Bridge Environment Variables
# Copy this file to .env and fill in your actual values

# Berachain RPC URL (for mainnet)
BERACHAIN_RPC_URL=https://rpc.berachain.com

# Berachain Testnet RPC URL (for testnet deployment)
BERACHAIN_TESTNET_RPC_URL=https://rpc.berachain-testnet.com

# Deployer private key (NEVER commit this)
PRIVATE_KEY=your_private_key_here

# Validator addresses (comma-separated)
VALIDATORS=0xvalidator1,0xvalidator2,0xvalidator3

# Validator threshold (number of signatures required)
VALIDATOR_THRESHOLD=2
