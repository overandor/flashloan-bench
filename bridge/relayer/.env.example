# Relayer Environment Variables
# Copy this file to .env and fill in your actual values

# Berachain RPC URL
BERACHAIN_RPC_URL=https://rpc.berachain.com

# Berachain bridge contract address
BERACHAIN_BRIDGE_ADDRESS=0x...

# Relayer private key (NEVER commit this)
RELAYER_PRIVATE_KEY=your_private_key_here

# Solana RPC URL
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana bridge program ID
SOLANA_BRIDGE_PROGRAM_ID=Br1dgE1111111111111111111111111111111111111

# Validator addresses (comma-separated, must match bridge contract)
VALIDATOR_ADDRESSES=0xvalidator1,0xvalidator2,0xvalidator3

# Validator threshold (must match bridge contract)
VALIDATOR_THRESHOLD=2

# Dry-run mode (set to "true" to print release requests without submitting)
DRY_RUN=true
